
import random

def explain_topic():
    topic = input("Enter your engineering topic: ")
    print(f"\nAI Study Companion")
    print(f"Topic: {topic}")
    print(f"\nStudy guide for {topic}:")
    print("1. Understand the basic concepts.")
    print("2. Learn important definitions and formulas.")
    print("3. Study examples and applications.")
    print("4. Practise previous exam questions.")
    print("5. Revise the topic regularly.")

def generate_notes():
    topic = input("Enter the topic for notes: ")
    print(f"\nRevision Notes: {topic}")
    print("- Understand the main concept.")
    print("- Write down important definitions.")
    print("- List key formulas and equations.")
    print("- Practise numerical problems.")
    print("- Review your class notes.")

def take_quiz():
    questions = [
        {
            "question": "What does CPU stand for?",
            "options": ["1. Central Processing Unit",
                        "2. Computer Personal Unit",
                        "3. Central Program Utility"],
            "answer": 1
        },
        {
            "question": "Which language is commonly used for AI?",
            "options": ["1. Python", "2. HTML", "3. CSS"],
            "answer": 1
        },
        {
            "question": "What is the full form of RAM?",
            "options": ["1. Read Access Memory",
                        "2. Random Access Memory",
                        "3. Run Active Memory"],
            "answer": 2
        }
    ]

    score = 0
    random.shuffle(questions)

    for q in questions:
        print("\n" + q["question"])
        for option in q["options"]:
            print(option)

        try:
            answer = int(input("Enter your answer (1-3): "))
            if answer == q["answer"]:
                print("Correct answer!")
                score += 1
            else:
                print("Incorrect. Correct answer:",
                      q["options"][q["answer"] - 1])
        except ValueError:
            print("Please enter a number.")

    print(f"\nYour score: {score}/{len(questions)}")

def create_study_plan():
    subject = input("Enter your engineering subject: ")
    try:
        days = int(input("How many days are available for preparation? "))
        if days <= 0:
            print("Please enter a positive number of days.")
            return

        print(f"\nStudy Plan for {subject}")
        for day in range(1, days + 1):
            print(f"Day {day}: Study concepts, practise questions, "
                  "and revise important points.")
    except ValueError:
        print("Please enter a valid number.")

def main():
    while True:
        print("\n===== AI Study Companion for Engineering Exams =====")
        print("1. Topic Study Guide")
        print("2. Generate Revision Notes")
        print("3. Take Practice Quiz")
        print("4. Create Study Plan")
        print("5. Exit")

        choice = input("Choose an option (1-5): ")

        if choice == "1":
            explain_topic()
        elif choice == "2":
            generate_notes()
        elif choice == "3":
            take_quiz()
        elif choice == "4":
            create_study_plan()
        elif choice == "5":
            print("Good luck with your engineering exams!")
            break
        else:
            print("Invalid choice. Please try again.")

if __name__ == "__main__":
    main()
